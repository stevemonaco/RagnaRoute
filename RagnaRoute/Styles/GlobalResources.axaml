<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="using:System">
    <sys:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</sys:Double>

    <Color x:Key="RefreshColor">#227653</Color>

    <!--  TimeState Colors  -->
    <Color x:Key="ActiveStateColor">#227653</Color>
    <Color x:Key="MaybeActiveStateColor">#39B884</Color>
    <Color x:Key="AwaitingUpcomingStateColor">#DF6626</Color>
    <Color x:Key="InactiveStateColor">Transparent</Color>
    <Color x:Key="EndedStateColor">#ac3232</Color>
</ResourceDictionary>
