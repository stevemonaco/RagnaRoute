<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fac="using:FluentAvalonia.UI.Controls"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core">

    <Style Selector="fac|FAPathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="fac|FAPathIcon.vflip">
        <Setter Property="RenderTransform" Value="scaley(-1)" />
    </Style>

    <Style Selector="fac|FAPathIcon.hflip">
        <Setter Property="RenderTransform" Value="scalex(-1)" />
    </Style>

    <Style Selector="fac|FAPathIcon.turn">
        <Setter Property="RenderTransform" Value="scale(-1)" />
    </Style>

    <Style Selector="fac|NavigationViewItem">
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style Selector="fac|NavigationViewItem.vflip fac|FAPathIcon">
        <Setter Property="RenderTransform" Value="scaley(-1)" />
    </Style>

    <Style Selector="fac|NavigationViewItem.hflip fac|FAPathIcon">
        <Setter Property="RenderTransform" Value="scalex(-1)" />
    </Style>

    <Style Selector="fac|NavigationViewItem.turn fac|FAPathIcon">
        <Setter Property="RenderTransform" Value="scale(-1)" />
    </Style>
</Styles>
