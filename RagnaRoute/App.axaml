<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RagnaRoute"
			 xmlns:sty="using:FluentAvalonia.Styling"
			 xmlns:con="using:RagnaRoute.Converters"
             x:Class="RagnaRoute.App">
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
		<sty:FluentAvaloniaTheme />
		<StyleInclude Source="avares://RagnaRoute/Styles/GlobalStyles.axaml" />
    </Application.Styles>

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://RagnaRoute/Styles/GlobalResources.axaml" />
				<ResourceInclude Source="avares://RagnaRoute/Styles/Icons.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
		
		<con:CooldownObjectiveToStringConverter x:Key="CooldownObjectiveToStringConverter" />
		<con:ScheduledObjectiveToStringConverter x:Key="ScheduledObjectiveToStringConverter" />
	</Application.Resources>
</Application>
