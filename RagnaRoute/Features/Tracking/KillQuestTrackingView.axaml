<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:vm="using:RagnaRoute.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:CompileBindings="True"
			 x:DataType="vm:KillQuestTrackingViewModel"
             x:Class="RagnaRoute.Views.KillQuestTrackingView">
	<UserControl.Styles>
		<Style Selector="Popup[IsOpen=true]">
			<Style.Animations>
				<Animation Duration="0:0:2">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0.0" />
					</KeyFrame>
					<KeyFrame Cue="10%">
						<Setter Property="Opacity" Value="1.0" />
					</KeyFrame>
					<KeyFrame Cue="90%">
						<Setter Property="Opacity" Value="1.0" />
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="0.0" />
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</UserControl.Styles>
	
	<Grid Name="grid">
		<Popup Name="popup" IsOpen="False" PlacementMode="Bottom">
			<TextBlock Background="Orange" Text="Text copied!" Opacity="{Binding #popup.Opacity}" />
		</Popup>
		
		<ScrollViewer HorizontalScrollBarVisibility="Disabled">
			<ItemsRepeater Items="{Binding Quests}" Margin="8 0 8 0">
				<ItemsRepeater.Layout>
					<!--<WrapLayout Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="8" />-->
					<UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="3" MinItemWidth="300" ItemsStretch="Uniform" MinRowSpacing="8" MinColumnSpacing="8" />
				</ItemsRepeater.Layout>

				<ItemsRepeater.ItemTemplate>
					<DataTemplate DataType="{x:Type vm:KillQuestViewModel}">
						<Border CornerRadius="8" Background="Transparent" BorderThickness="4" BorderBrush="Blue">
							<StackPanel Name="card">
								<StackPanel Background="#1B1B42" Orientation="Horizontal" ToolTip.Tip="{Binding Description}">
									<TextBlock Text="{Binding Name}" FontWeight="Bold" />
									<TextBlock HorizontalAlignment="Right" Margin="8,0,0,0" Text="{Binding TimeUntilStarting}" />
									<TextBlock Margin="8,0,0,0" Text="{Binding TimeUntilEnding}" />
								</StackPanel>
								<TextBlock Text="{Binding Description}" Width="{ReflectionBinding #card.Width}" TextWrapping="Wrap" />
								<StackPanel Background="#20204C" Orientation="Horizontal">
									<ItemsControl Items="{Binding Information}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel Orientation="Horizontal" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Button Background="Blue" Click="InfoButton_Clicked" ToolTip.Tip="{Binding}">
													<Button.Content>
														<ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF0E3;"/>
													</Button.Content>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<Button HorizontalAlignment="Right" Margin="8,0,0,0" Command="{Binding ResetObjectiveCommand}" Content="Reset" />
								</StackPanel>
							</StackPanel>
						</Border>

					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>
		</ScrollViewer>
	</Grid>
</UserControl>
