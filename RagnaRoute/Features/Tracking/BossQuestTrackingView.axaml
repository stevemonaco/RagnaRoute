<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:RagnaRoute.ViewModels"
			 xmlns:con="using:RagnaRoute.Converters"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:CompileBindings="True"
			 x:DataType="vm:BossQuestTrackingViewModel"
             x:Class="RagnaRoute.Views.BossQuestTrackingView">
	<Grid RowDefinitions="auto,*">
		<StackPanel Orientation="Horizontal">
			<TextBox Text="{Binding FilterText}" />
			<ToggleButton IsChecked="{Binding ShouldShowHidden}" Content="Hidden" />
		</StackPanel>
		
		<ScrollViewer Grid.Row="1">
			<ItemsRepeater Items="{Binding Bosses}">
				<ItemsRepeater.Layout>
					<StackLayout Orientation="Vertical" />
				</ItemsRepeater.Layout>
				<ItemsRepeater.ItemTemplate>
					<DataTemplate DataType="{x:Type vm:BossQuestViewModel}">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="{Binding Name}" />
							<TextBlock Margin="8,0,0,0" Text="{Binding TimeUntilStarting, Converter={x:Static con:AppConverters.DurationToString}}" />
							<TextBlock Margin="8,0,0,0" Text="{Binding TimeUntilEnding, Converter={x:Static con:AppConverters.DurationToString}}" />
							<TextBlock Margin="8,0,0,0" Text="{Binding TimeState}" />

							<ItemsControl Items="{Binding Information}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Button Background="Blue" Click="InfoButton_Clicked" ToolTip.Tip="{Binding}">
											<Button.Content>
												<ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF0E3;"/>
											</Button.Content>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							
							<Button Margin="8,0,0,0" Command="{Binding ResetObjectiveCommand}" Content="Reset" />
							<ToggleButton IsChecked="{Binding IsHidden}" Content="Hidden" />
						</StackPanel>
					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>
		</ScrollViewer>
	</Grid>
</UserControl>
