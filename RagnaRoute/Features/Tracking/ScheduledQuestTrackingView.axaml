<UserControl
    x:Class="RagnaRoute.Views.ScheduledQuestTrackingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="using:RagnaRoute.Converters"
    xmlns:fac="using:FluentAvalonia.UI.Controls"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:obj="using:RagnaRoute.Objectives"
    xmlns:res="using:RagnaRoute.Resources"
    xmlns:vm="using:RagnaRoute.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:ScheduledQuestTrackingViewModel">
    <UserControl.Styles>
        <Style Selector="Popup[IsOpen=true]">
            <Style.Animations>
                <Animation Duration="0:0:2">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="75%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="grid">
        <Popup x:Name="popup" IsOpen="False" PlacementMode="Bottom">
            <Border BorderBrush="Black" BorderThickness="1">
                <TextBlock Background="Orange" Opacity="{Binding #popup.Opacity}" Text="Text copied!" />
            </Border>
        </Popup>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="items" Margin="8,0,8,0" ItemsSource="{Binding Quests}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="None"
                        MinColumnSpacing="8"
                        MinItemWidth="300"
                        MinRowSpacing="8"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScheduledQuestViewModel}">
                        <Border Background="Transparent" BorderBrush="Black" BorderThickness="2" CornerRadius="10, 10, 6, 6">
                            <i:Interaction.Behaviors>
                                <ia:DataTriggerBehavior Binding="{Binding TimeState}" Value="{x:Static obj:TimeState.Active}">
                                    <ia:ChangePropertyAction PropertyName="Background" Value="{StaticResource ActiveStateColor}" />
                                </ia:DataTriggerBehavior>
                                <ia:DataTriggerBehavior Binding="{Binding TimeState}" Value="{x:Static obj:TimeState.MaybeActive}">
                                    <ia:ChangePropertyAction PropertyName="Background" Value="{StaticResource MaybeActiveStateColor}" />
                                </ia:DataTriggerBehavior>
                                <ia:DataTriggerBehavior Binding="{Binding TimeState}" Value="{x:Static obj:TimeState.AwaitingUpcoming}">
                                    <ia:ChangePropertyAction PropertyName="Background" Value="{StaticResource AwaitingUpcomingStateColor}" />
                                </ia:DataTriggerBehavior>
                                <ia:DataTriggerBehavior Binding="{Binding TimeState}" Value="{x:Static obj:TimeState.Inactive}">
                                    <ia:ChangePropertyAction PropertyName="Background" Value="{StaticResource InactiveStateColor}" />
                                </ia:DataTriggerBehavior>
                                <ia:DataTriggerBehavior Binding="{Binding TimeState}" Value="{x:Static obj:TimeState.Ended}">
                                    <ia:ChangePropertyAction PropertyName="Background" Value="{StaticResource EndedStateColor}" />
                                </ia:DataTriggerBehavior>
                            </i:Interaction.Behaviors>

                            <Grid RowDefinitions="auto,auto">
                                <Grid Background="Transparent" ToolTip.Tip="{Binding Description}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="{Binding Name}" />
                                </Grid>

                                <Grid Grid.Row="1" Background="{DynamicResource NavigationViewDefaultPaneBackground}" RowDefinitions="auto,auto">
                                    <TextBlock HorizontalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static con:AppConverters.ScheduledObjectiveToString}">
                                                <Binding Path="TimeUntilStarting" />
                                                <Binding Path="TimeUntilEnding" />
                                                <Binding Path="TimeState" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <ItemsRepeater ItemsSource="{Binding Information}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="InfoButton_Clicked" ToolTip.Tip="{Binding}">
                                                        <Button.Content>
                                                            <fac:FAPathIcon Data="{x:Static res:AppIcons.ClipboardCopy}" />
                                                        </Button.Content>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <Button Command="{Binding #items.((vm:ScheduledQuestTrackingViewModel)DataContext).CompleteObjectiveCommand}" CommandParameter="{Binding}">
                                            <fac:FAPathIcon Classes="vflip" Data="{x:Static res:AppIcons.Skull}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
