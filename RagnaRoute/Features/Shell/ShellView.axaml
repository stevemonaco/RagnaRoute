<Window
    x:Class="RagnaRoute.Views.ShellView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fac="using:FluentAvalonia.UI.Controls"
    xmlns:res="using:RagnaRoute.Resources"
    xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
    xmlns:ve="using:RagnaRoute.ViewExtenders"
    xmlns:vm="using:RagnaRoute.ViewModels"
    Title="RagnaRoute"
    x:CompileBindings="True"
    x:DataType="vm:ShellViewModel"
    Icon="/Assets/avalonia-logo.ico"
    UseLayoutRounding="True">
    <Window.Resources>
        <ve:MenuTemplateSelector x:Key="menuTemplateSelector">
            <DataTemplate x:Key="{x:Type vm:BossQuestTrackingViewModel}" DataType="vm:BossQuestTrackingViewModel">
                <fac:NavigationViewItem Classes="vflip" Content="{Binding DisplayName}">
                    <fac:NavigationViewItem.IconSource>
                        <fac:PathIconSource Data="{x:Static res:AppIcons.BossTracker}" />
                    </fac:NavigationViewItem.IconSource>
                </fac:NavigationViewItem>
            </DataTemplate>
            <DataTemplate x:Key="{x:Type vm:ScheduledQuestTrackingViewModel}" DataType="vm:ScheduledQuestTrackingViewModel">
                <fac:NavigationViewItem Classes="vflip" Content="{Binding DisplayName}">
                    <fac:NavigationViewItem.IconSource>
                        <fac:PathIconSource Data="{x:Static res:AppIcons.ScheduledTracker}" />
                    </fac:NavigationViewItem.IconSource>
                </fac:NavigationViewItem>
            </DataTemplate>
            <DataTemplate x:Key="{x:Type vm:QuestHistoryViewModel}" DataType="vm:QuestHistoryViewModel">
                <fac:NavigationViewItem Classes="vflip" Content="{Binding DisplayName}">
                    <fac:NavigationViewItem.IconSource>
                        <fac:PathIconSource Data="{x:Static res:AppIcons.History}" />
                    </fac:NavigationViewItem.IconSource>
                </fac:NavigationViewItem>
            </DataTemplate>
        </ve:MenuTemplateSelector>
    </Window.Resources>

    <Grid RowDefinitions="auto, *">
        <Grid Margin="10,5,10,10" ColumnDefinitions="auto, *">
            <TextBlock Text="RagnaRoute" />
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Text="{Binding TrackerProfile.ProfileName}" />
                <TextBlock Margin="5,0,0,0" Text="{Binding TrackerProfile.TrackerTime}" />
            </StackPanel>
        </Grid>

        <fac:NavigationView
            x:Name="nav"
            Grid.Row="1"
            IsSettingsVisible="False"
            MenuItemTemplateSelector="{StaticResource menuTemplateSelector}"
            MenuItemsSource="{Binding MenuItems}"
            PaneDisplayMode="Auto"
            SelectedItem="{Binding SelectedMenuItem}">
            <fac:NavigationView.Content>
                <ContentControl Content="{Binding #nav.SelectedItem}" />
            </fac:NavigationView.Content>
        </fac:NavigationView>
    </Grid>
</Window>
