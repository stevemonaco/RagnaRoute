<Window
    x:Class="RagnaRoute.Views.ShellView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
    xmlns:ve="using:RagnaRoute.ViewExtenders"
    xmlns:vm="using:RagnaRoute.ViewModels"
    Title="RagnaRoute"
    x:CompileBindings="True"
    x:DataType="vm:ShellViewModel"
    Icon="/Assets/avalonia-logo.ico"
    UseLayoutRounding="True">
    <Window.Styles>
        <Style Selector="ui|NavigationViewItem.flip ui|FAPathIcon">
            <Setter Property="RenderTransform" Value="scaley(-1)" />
        </Style>
    </Window.Styles>
    <Window.Resources>
        <ve:MenuTemplateSelector x:Key="menuTemplateSelector">
            <DataTemplate x:Key="{x:Type vm:BossQuestTrackingViewModel}" DataType="vm:BossQuestTrackingViewModel">
                <ui:NavigationViewItem Classes="flip" Content="{Binding DisplayName}">
                    <ui:NavigationViewItem.IconSource>
                        <ui:PathIconSource Data="{StaticResource iconBossTracker}" />
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </DataTemplate>
            <DataTemplate x:Key="{x:Type vm:ScheduledQuestTrackingViewModel}" DataType="vm:ScheduledQuestTrackingViewModel">
                <ui:NavigationViewItem Classes="flip" Content="{Binding DisplayName}">
                    <ui:NavigationViewItem.IconSource>
                        <ui:PathIconSource Data="{StaticResource iconScheduledTracker}" />
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </DataTemplate>
            <DataTemplate x:Key="{x:Type vm:QuestHistoryViewModel}" DataType="vm:QuestHistoryViewModel">
                <ui:NavigationViewItem Classes="flip" Content="{Binding DisplayName}">
                    <ui:NavigationViewItem.IconSource>
                        <ui:PathIconSource Data="{StaticResource iconHistory}" />
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </DataTemplate>
        </ve:MenuTemplateSelector>
    </Window.Resources>

    <Grid RowDefinitions="auto, *">
        <Grid Margin="10,5,10,10" ColumnDefinitions="auto, *">
            <TextBlock Text="RagnaRoute" />
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Text="{Binding TrackerProfile.ProfileName}" />
                <TextBlock Margin="5,0,0,0" Text="{Binding TrackerProfile.TrackerTime}" />
            </StackPanel>
        </Grid>

        <ui:NavigationView
            x:Name="nav"
            Grid.Row="1"
            IsSettingsVisible="False"
            MenuItemTemplateSelector="{StaticResource menuTemplateSelector}"
            MenuItemsSource="{Binding MenuItems}"
            PaneDisplayMode="Auto"
            SelectedItem="{Binding SelectedMenuItem}">
            <ui:NavigationView.Content>
                <ContentControl Content="{Binding #nav.SelectedItem}" />
            </ui:NavigationView.Content>

            <!--<ui:NavigationView.MenuItems>
				<ui:NavigationViewItem Content="MVPs" />
				<ui:NavigationViewItem Content="Daily Instances" />
				<ui:NavigationViewItem Content="Eden Mission 1-39" />
				<ui:NavigationViewItem Content="Eden Mission 40-69" />
				<ui:NavigationViewItem Content="Eden Mission 70-99" />
				<ui:NavigationViewItem Content="Eden Mission 100-110" />
				<ui:NavigationViewItem Content="Eden Mission 120-140" />
				<ui:NavigationViewItem Content="Eden Mission 130-190" />
				<ui:NavigationViewItem Content="Eden Mission 175+" />
				<ui:NavigationViewItem Content="Eden Mission 200+" />
				<ui:NavigationViewItem Content="Eden Mission 200-230+" />
				<ui:NavigationViewItem Content="Market" />
			</ui:NavigationView.MenuItems>-->
        </ui:NavigationView>
    </Grid>
</Window>
