<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:RagnaRoute.ViewModels"
			 xmlns:con="using:RagnaRoute.Converters"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:obj="using:RagnaRoute.Objectives"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
			 xmlns:data="using:RagnaRoute.Data"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:CompileBindings="True"
			 x:DataType="vm:QuestHistoryViewModel"
             x:Class="RagnaRoute.Views.QuestHistoryView">
	<Grid RowDefinitions="auto,*">
		<StackPanel Spacing="8" Margin="10" Orientation="Horizontal">
			<ComboBox MinWidth="200" Items="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}" />
			<ComboBox MinWidth="200" Items="{Binding ObjectiveNames}" SelectedItem="{Binding SelectedObjectiveName}" />
			<Button Command="{Binding UpdateHistoryCommand}" ToolTip.Tip="Refresh" IsEnabled="{Binding SelectedObjectiveName, Converter={x:Static ObjectConverters.IsNotNull}}">
				<ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" Foreground="#37946e" />
			</Button>
		</StackPanel>

		<ScrollViewer Grid.Row="1">
			<ItemsRepeater Items="{Binding Completions}">
				<ItemsRepeater.Layout>
					<StackLayout Orientation="Vertical" />
				</ItemsRepeater.Layout>
				<ItemsRepeater.ItemTemplate>
					<DataTemplate DataType="{x:Type data:QuestCompletionDto}">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="{Binding Profile}" />
							<TextBlock Text="{Binding Name}" />
							<TextBlock Text="{Binding CompletionTime}" />
						</StackPanel>
					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>
		</ScrollViewer>
	</Grid>
</UserControl>
