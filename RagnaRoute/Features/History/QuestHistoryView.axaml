<UserControl
    x:Class="RagnaRoute.Views.QuestHistoryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="using:RagnaRoute.Converters"
    xmlns:data="using:RagnaRoute.Data"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:obj="using:RagnaRoute.Objectives"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:RagnaRoute.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:QuestHistoryViewModel">
    <Grid RowDefinitions="auto,auto,*">
        <StackPanel Margin="10" Orientation="Horizontal" Spacing="8">
            <ComboBox MinWidth="200" Items="{Binding FamilyNames, Mode=OneTime}" SelectedItem="{Binding SelectedFamilyName, Mode=TwoWay}" />
            <ComboBox MinWidth="200" Items="{Binding ObjectiveNames, Mode=OneTime}" SelectedItem="{Binding SelectedObjectiveName, Mode=TwoWay}" />
            <Button Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
                <ui:FAPathIcon Data="{StaticResource iconRefresh}" Foreground="{StaticResource RefreshColor}" />
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding CompletionCount, StringFormat='Completions: {0}'}" />

        <ScrollViewer Grid.Row="2">
            <ItemsRepeater Items="{Binding Completions}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="{x:Type data:CompletionDto}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CompletionTime, Converter={x:Static con:AppConverters.InstantToLocalString}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
